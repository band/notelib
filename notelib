notelibv () { echo Release 0.3.0: notelib version 0.3.0; }
# CLI note taking functions
# from: http://lifehacker.com/5592047/turn-your-command-line-into-a-fast-and-simple-note+taking-tool
# early updates from mcgowan@alum.mit.edu (1944 -  2026)
# 2026-02-21 zsh-specific assistance from Claude Sonnet 4.6
# 2026-08-10 bash/zsh normalization - assistance from kumo (Claude Opus 5)
# Install: `source notelib`
#
# Portability: one code path, no shell detection, no ifdefs.
# Targets zsh 5.x and bash 3.2 (the macOS system bash).
notelib () {
    : debug ENTRY $# "$@"
    case "${1:-__NADA__}" in
	(__NADA__|-h|--help|help) notelib_help ;;
	(-V|--version) notelibv ;;
	(*) notelib_help ;;
    esac
}

notelib_help () {
    : display help text
    cat <<'EOF'
NAME
  notelib - functions for command-line text or markdown note taking

SYNOPSIS
  n [notefile_name]		Create a new note or Open an existing note; default name is a timestamp
  nlast [pattern]		Edit most recent note or first note name matching pattern
  nls [pattern]			List notes matching name, or with no argument, list all
  notelib [-V|--version]	Display release/version info
  notelib [-h|--help|help]	Display this help info

ENVIRONMENT
  NOTES_DIR	The notes directory. `~/text/notes` is the default if not set
  EDITOR	The editor app used to create and update notes
EOF
}

_notelib_dir () {
    printf '%s\n' "${NOTES_DIR:-${HOME}/text/notes}"
}

_notelib_find () {
    : list note files in $1 whose name contains $2, one per line, sorted by name
    find "$1" -maxdepth 1 -type f \
	 \( -iname "*$2*.txt" -o -iname "*$2*.md" \) 2>/dev/null | sort
}

_notelib_edit () {
    : open $1 in $EDITOR, which may itself carry arguments
    : eval word-splits EDITOR the same way in both shells
    [[ -z "$EDITOR" ]] && { printf '%s\n' "Error: \$EDITOR is not set" >&2; return 1; }
    eval "$EDITOR \"\$1\""
}

n () {
    : create or edit a text or markdown note
    [[ -z "$EDITOR" ]] && { printf '%s\n' "Error: \$EDITOR is not set" >&2; return 1; }
    local notes_dir="$(_notelib_dir)"
    local name="$1"
    if [[ -z "$name" ]]; then
        name="$(TZ=UTC date +%Y-%m-%dT%H-%MZ).md"
    else
        case "$name" in
            (.|..|*/*|-*) printf '%s\n' "Error: invalid note name '$name'" >&2; return 1 ;;
            (*.*) ;;
            (*) name="${name}.md" ;;
        esac
    fi
    mkdir -p -- "$notes_dir" || return 1
    _notelib_edit "$notes_dir/$name"
}

nls () {
    : list notes
    local notes_dir f
    notes_dir="$(_notelib_dir)"
    local -a files
    files=()
    while IFS= read -r f
    do
	files+=("$f")
    done < <(_notelib_find "$notes_dir" "${1:-}")

    if (( ${#files[@]} == 0 ))
    then
	printf '%s\n' "No notes found${1:+ matching '$1'}" >&2
	return 1
    fi
    ls -Flrt -- "${files[@]}"
}

nlast () {
    : edit the most recent note or the first note name matching the argument text
    local notes_dir f pick=""
    notes_dir="$(_notelib_dir)"

    if (( $# == 0 ))
    then
	while IFS= read -r f
	do
	    [[ -z "$pick" || "$f" -nt "$pick" ]] && pick="$f"
	done < <(_notelib_find "$notes_dir" "")
	[[ -n "$pick" ]] || { printf '%s\n' "nlast: no notes in ${notes_dir:-<unset>}" >&2; return 1; }
    else
	while IFS= read -r f
	do
	    pick="$f"
	    break
	done < <(_notelib_find "$notes_dir" "$1")
	[[ -n "$pick" ]] || { printf '%s\n' "No notes found matching '$1'" >&2; return 1; }
    fi

    _notelib_edit "$pick"
}
